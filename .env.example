# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Who may use the app (comma-separated). Leave empty to allow any signed-in user. ---
ALLOWED_EMAILS=you@example.com,partner@example.com

# --- Plaid (dashboard.plaid.com -> Developers -> Keys) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Public URL Plaid should POST webhooks to (your deployed site). Optional in local dev.
PLAID_WEBHOOK_URL=https://your-app.vercel.app/api/plaid/webhook
# Required for OAuth institutions like Chase in production. Must be registered in the Plaid dashboard.
PLAID_REDIRECT_URI=

# 32-byte key, base64. Encrypts Plaid access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_KEY=
