# --- Supabase (Project Settings -> Data API / API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Who may use the app (comma-separated). Leave empty to allow any signed-in user. ---
ALLOWED_EMAILS=you@example.com,partner@example.com

# 32-byte key, base64. Encrypts the SimpleFIN access URL at rest. Never change it once set.
# Generate in a browser console: btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))))
# (Older deployments may call this PLAID_TOKEN_KEY; that name still works.)
ENCRYPTION_KEY=

# Random string. Vercel sends it to /api/cron/sync so only Vercel can trigger the daily sync.
CRON_SECRET=

# --- Email reminders (optional) ---
# API key from resend.com (free). Without a verified domain, Resend only delivers to the email you signed up with.
RESEND_API_KEY=
# Sender. Leave empty to use Resend's shared test sender (onboarding@resend.dev).
REMINDER_FROM=
